{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "rootDir": "lib",
    "outDir": "packages/asos-kernel/dist",
    "lib": ["ESNext"]
  },
  "include": [
    "lib/domain/**/*.ts",
    "lib/kernel/**/*.ts",
    "lib/application/**/*.ts",
    "lib/public/**/*.ts"
  ]
}
